# PhishGuard Backend environment variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# SQLAlchemy database URL (SQLite by default)
DATABASE_URL=sqlite:///phishguard.db

# Qwen / OpenAI-compatible LLM API — keep secret, backend only!
QWEN_API_KEY=your-qw…here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Flask
FLASK_SECRET_KEY=change…ring
FLASK_DEBUG=0
